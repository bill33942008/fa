{
  "llm": {
    "enabled": true,
    "provider": "openai-compatible",
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "https://api.openai.com/v1/chat/completions",
    "model": "gpt-4.1-mini",
    "temperature": 0.7,
    "max_tokens": 1400
  },
  "notification": {
    "feishu": {
      "enabled": false,
      "webhook_url": ""
    },
    "email": {
      "enabled": false,
      "smtp_host": "smtp.example.com",
      "smtp_port": 465,
      "sender": "bot@example.com",
      "password_env": "SMTP_PASSWORD",
      "receivers": [
        "you@example.com"
      ]
    }
  },
  "feishu_bitable": {
    "enabled": false,
    "app_id_env": "FEISHU_APP_ID",
    "app_secret_env": "FEISHU_APP_SECRET",
    "app_token": "",
    "table_id": "",
    "auto_create_fields": true
  },
  "generation": {
    "topics_per_track": 6,
    "default_timezone": "Asia/Shanghai"
  },
  "preview": {
    "enabled": true,
    "public_base_url": "http://YOUR_SERVER_IP:8787"
  },
  "cloud_media": {
    "enabled": false,
    "image": {
      "enabled": false,
      "provider": "replicate",
      "api_token_env": "REPLICATE_API_TOKEN",
      "model": "black-forest-labs/flux-schnell",
      "images_per_item": 3,
      "aspect_ratio": "9:16",
      "output_format": "jpg",
      "auto_render_on_plan_day": false,
      "max_retries": 4,
      "retry_backoff_seconds": 2,
      "item_delay_seconds": 1.5,
      "poll_interval_seconds": 3,
      "timeout_seconds": 600
    },
    "video": {
      "enabled": false,
      "provider": "replicate",
      "api_token_env": "REPLICATE_API_TOKEN",
      "model": "minimax/video-01",
      "duration_seconds": 8,
      "aspect_ratio": "9:16",
      "include_blocked": false,
      "auto_render_on_plan_day": false,
      "max_retries": 4,
      "retry_backoff_seconds": 2,
      "item_delay_seconds": 2.5,
      "poll_interval_seconds": 5,
      "timeout_seconds": 1200
    }
  },
  "local_gpu": {
    "enabled": false,
    "auto_export_on_plan_day": true,
    "jobs_dir": "state/video_jobs",
    "comfyui_url": "http://127.0.0.1:8000",
    "comfyui": {
      "url": "http://127.0.0.1:8000",
      "render_mode": "slideshow",
      "workflow_file": "short_video.api.json",
      "workflow_dir": "workflows",
      "checkpoint_name": "",
      "checkpoint_candidates": [
        "dreamshaper_8.safetensors",
        "majicmixRealistic_v7.safetensors",
        "v1-5-pruned-emaonly.safetensors",
        "sd_xl_base_1.0.safetensors"
      ],
      "width": 720,
      "height": 1280,
      "max_segments": 6,
      "tts_voice": "zh-CN-XiaoxiaoNeural",
      "base_seed": 42,
      "poll_interval_seconds": 3,
      "timeout_seconds": 3600
    },
    "upload": {
      "enabled": true,
      "method": "scp",
      "server_host": "YOUR_SERVER_IP",
      "server_user": "root",
      "server_port": 22,
      "remote_media_dir": "/opt/fa/automation/previews/media",
      "remote_pipeline_dir": "/opt/fa",
      "remote_python": "/opt/fa/.venv/bin/python",
      "remote_config": "/opt/fa/automation/config.json",
      "ssh_identity_file": ""
    }
  },
  "sample_video": {
    "enabled": true,
    "auto_render_on_plan_day": false,
    "include_blocked": false,
    "public_base_url": "http://YOUR_SERVER_IP:8787",
    "tts_engine": "edge-tts",
    "tts_binary": "edge-tts",
    "tts_voice": "zh-CN-XiaoxiaoNeural",
    "tts_speed": 165,
    "segment_gap_seconds": 0.25,
    "lead_in_seconds": 0.4,
    "min_duration_seconds": 8,
    "max_segments": 8,
    "width": 720,
    "height": 1280,
    "fps": 25,
    "background_color": "#111827"
  },
  "quality_scoring": {
    "enabled": true,
    "llm_review_enabled": true,
    "publish_threshold": 80,
    "revise_threshold": 60
  },
  "quality_guard": {
    "enabled": true,
    "block_score_threshold": 60,
    "min_body_chars": 120,
    "min_hook_chars": 10,
    "notify_on_block": true,
    "target_statuses": [
      "pending_review",
      "approved",
      "ready_to_post"
    ],
    "placeholder_patterns": [
      "围绕以上选题，结合账号定位给出可执行观点，避免空泛结论。",
      "用一个反常识观点开场，提升完播和阅读意愿。",
      "无摘要，建议补充自己的观察。"
    ]
  },
  "tracks": {
    "football": {
